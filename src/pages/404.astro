---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/url';
---

<BaseLayout title="ページが見つかりません">
  <section class="flex min-h-svh items-center px-5 sm:px-8">
    <div class="mx-auto w-full max-w-6xl">
      <p class="font-display text-7xl font-black text-sakura sm:text-9xl">404</p>
      <h1 class="mt-4 font-display text-2xl font-black text-ink sm:text-3xl">ページが見つかりませんでした</h1>
      <p class="mt-3 text-ink-soft">URLが変わったか、ページが移動した可能性があります。</p>
      <a href={withBase('/')} class="mt-8 inline-flex rounded-full bg-sakura px-7 py-3 font-bold text-ink transition-colors hover:bg-sakura-soft">
        トップページへ戻る
      </a>
    </div>
  </section>
</BaseLayout>
