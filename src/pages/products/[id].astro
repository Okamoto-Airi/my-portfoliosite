---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getProducts } from '../../lib/products';
import { withBase } from '../../lib/url';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: products[i - 1], next: products[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const isTeam = data.kind === 'チーム開発';
const info = [
  { label: '種別', value: data.kind },
  { label: '期間', value: `${data.period}（${data.duration}）` },
  data.teamSize ? { label: '制作人数', value: `${data.teamSize}名` } : null,
  data.role ? { label: '担当箇所', value: data.role } : null,
].filter((item): item is { label: string; value: string } => item !== null);
---

<BaseLayout title={data.title} description={data.description}>
  <article class="px-5 pb-24 pt-28 sm:px-8">
    <div class="mx-auto max-w-6xl">
      <a
        href={withBase('/#products')}
        class="mb-8 inline-flex items-center gap-1 rounded-full bg-white/80 py-1.5 pl-2 pr-4 text-sm font-medium text-ink transition-colors hover:bg-sakura-soft"
      >
        <Icon name="chevron-left" size={18} />
        作品一覧に戻る
      </a>

      <header class="max-w-3xl">
        <p>
          <span class:list={['rounded-full px-3 py-0.5 text-sm font-bold', isTeam ? 'bg-sakura-soft text-rose' : 'bg-mint-soft text-mint-deep']}>
            {data.kind}
          </span>
        </p>
        <h1 class="mt-4 font-display text-4xl font-black leading-tight text-ink sm:text-6xl">{data.title}</h1>
        <p class="mt-4 text-lg text-ink-soft">{data.description}</p>
      </header>

      <div class="mt-10 overflow-hidden rounded-[2rem] bg-sakura-tint shadow-[0_24px_60px_-28px_rgba(185,58,95,0.45)]">
        <Image
          src={data.thumbnail}
          alt={data.thumbnailAlt}
          widths={[720, 1080, 1440]}
          sizes="(min-width: 1152px) 1104px, 92vw"
          loading="eager"
          class="block w-full rounded-[2rem] object-cover"
          style={`aspect-ratio: ${data.thumbnail.width} / ${data.thumbnail.height}`}
          transition:name={`thumb-${entry.id}`}
        />
      </div>

      <div class="mt-14 grid gap-12 lg:grid-cols-[19rem_1fr] lg:gap-16">
        <aside class="space-y-8 lg:sticky lg:top-24 lg:self-start">
          <dl class="space-y-4">
            {
              info.map((item) => (
                <div>
                  <dt class="text-sm font-bold text-rose">{item.label}</dt>
                  <dd class="mt-0.5 leading-relaxed text-ink">{item.value}</dd>
                </div>
              ))
            }
          </dl>

          <div>
            <h2 class="mb-3 text-sm font-bold text-rose">使用技術</h2>
            <ul class="flex flex-wrap gap-2">
              {data.technologies.map((tech) => <li class="rounded-full bg-butter px-3 py-0.5 text-sm text-ink">{tech}</li>)}
            </ul>
          </div>

          {
            (data.deployUrl || data.repos.length > 0 || data.repoPrivate) && (
              <div>
                <h2 class="mb-3 text-sm font-bold text-rose">リンク</h2>
                <ul class="flex flex-wrap gap-2">
                  {data.deployUrl && (
                    <li>
                      <a
                        href={data.deployUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="link-button bg-mint text-ink hover:bg-mint-soft"
                      >
                        <Icon name="external" size={16} />
                        {data.deployLabel ?? '公開サイト'}
                        <span class="sr-only">（新しいタブで開きます）</span>
                      </a>
                    </li>
                  )}
                  {data.repos.map((repo) => (
                    <li>
                      <a
                        href={repo.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="link-button bg-ink text-white hover:bg-ink-soft"
                      >
                        <Icon name="github" size={16} />
                        {repo.label}
                        <span class="sr-only">（新しいタブで開きます）</span>
                      </a>
                    </li>
                  ))}
                  {data.repoPrivate && (
                    <li>
                      <span class="link-button bg-white text-ink-soft">
                        <Icon name="lock" size={16} />
                        リポジトリは非公開
                      </span>
                    </li>
                  )}
                </ul>
              </div>
            )
          }
        </aside>

        <div class="prose-ja">
          <Content />
        </div>
      </div>

      <nav aria-label="ほかの作品" class="mt-24 grid gap-4 sm:grid-cols-2">
        {
          prev ? (
            <a href={withBase(`/products/${prev.id}/`)} class="pager justify-start">
              <Icon name="chevron-left" size={20} class="shrink-0 text-rose" />
              <span>
                <span class="block text-xs text-ink-soft">前の作品</span>
                <span class="font-display text-lg font-bold">{prev.data.title}</span>
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={withBase(`/products/${next.id}/`)} class="pager justify-end text-right">
              <span>
                <span class="block text-xs text-ink-soft">次の作品</span>
                <span class="font-display text-lg font-bold">{next.data.title}</span>
              </span>
              <Icon name="chevron-right" size={20} class="shrink-0 text-rose" />
            </a>
          )
        }
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .link-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    font-size: 0.9rem;
    font-weight: 700;
    transition: background-color 0.2s;
  }
  .pager {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem;
    border-radius: 1.5rem;
    background: white;
    color: var(--color-ink);
    box-shadow: 0 10px 28px -18px rgb(185 58 95 / 0.4);
    transition:
      transform 0.3s var(--ease-spring),
      box-shadow 0.3s;
  }
  .pager:hover {
    transform: translateY(-3px);
    box-shadow: 0 18px 34px -18px rgb(185 58 95 / 0.5);
  }
</style>
