---
import { Image } from 'astro:assets';
import icon from '../assets/icon.jpg';
import SectionHeading from './SectionHeading.astro';
---

<section id="about" class="px-5 py-24 sm:px-8">
  <div class="mx-auto max-w-6xl">
    <SectionHeading title="About me" />

    <div class="about-panel grid gap-10 bg-white/80 p-8 shadow-[0_24px_60px_-30px_rgba(185,58,95,0.35)] md:grid-cols-[auto_1fr] md:gap-14 md:p-14">
      <div class="flex justify-center md:justify-start">
        <div class="h-fit rounded-full bg-gradient-to-br from-sakura to-mint p-1.5">
          <Image
            src={icon}
            alt="Okamoto Airi"
            width={320}
            height={320}
            class="h-36 w-36 rounded-full border-4 border-white object-cover md:h-44 md:w-44"
          />
        </div>
      </div>

      <div>
        <h3 class="font-display text-3xl font-black text-ink">Okamoto Airi</h3>
        <p class="mt-4 leading-relaxed text-ink-soft">
          4年制のIT専門学校に通っている学生です（3年 / 28卒）<br />
          Web技術を中心に幅広いIT分野を学んでいます。
        </p>
        <div class="mt-8 max-w-2xl space-y-4 leading-loose text-ink">
          <p>
            私は、誰かが感じている「ちょっとした不満」や「不便さ」を技術で解決することで、人の役に立てるエンジニアになりたいと考えています。
          </p>
          <p>
            日々の学習では、単に知識を増やすだけでなく、自分なりに手を動かしながら試行錯誤を重ねることを大切にしています。
          </p>
          <p>
            将来は、ユーザーの気持ちに寄り添い、小さな課題にも丁寧に向き合えるエンジニアを目指しています。
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* 角の丸みを非対称にして、カードの型にはまった印象を避ける */
  .about-panel {
    border-radius: 2.5rem 2.5rem 2.5rem 6rem;
  }
  @media (max-width: 767px) {
    .about-panel {
      border-radius: 2rem 2rem 2rem 4rem;
    }
  }
</style>
