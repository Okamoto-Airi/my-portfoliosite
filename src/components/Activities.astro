---
import SectionHeading from './SectionHeading.astro';
import Icon from './Icon.astro';
import { getActivities, hasDetail } from '../lib/activities';
import { withBase } from '../lib/url';

const activities = await getActivities();
---

<section id="activities" class="bg-mint-soft/50 px-5 py-24 sm:px-8">
  <div class="mx-auto max-w-6xl">
    <SectionHeading title="Activities" />

    <ol class="timeline relative max-w-3xl">
      {
        activities.map((activity) => (
          <li class="timeline__item relative grid grid-cols-[1fr] gap-x-6 pb-8 pl-9 last:pb-0 sm:grid-cols-[10.5rem_1fr]">
            <span class="timeline__dot" aria-hidden="true" />
            <time class="font-display font-bold text-rose">{activity.data.date}</time>
            <p class="text-ink">
              {activity.data.title}
              {hasDetail(activity) && (
                <a href={withBase(`/activities/${activity.id}/`)} class="timeline__more">
                  詳細
                  <Icon name="chevron-right" size={16} />
                </a>
              )}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .timeline::before {
    content: '';
    position: absolute;
    left: 0.4375rem;
    top: 0.9rem;
    bottom: 0.9rem;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(var(--color-sakura), var(--color-mint));
    transform-origin: top;
  }
  .timeline__dot {
    position: absolute;
    left: 0;
    top: 0.55rem;
    width: 0.9375rem;
    height: 0.9375rem;
    border-radius: 50%;
    background: var(--color-sakura);
    box-shadow: 0 0 0 4px var(--color-mist);
  }

  /* 詳細ページがある行にだけ出す「詳細」リンク */
  .timeline__more {
    display: inline-flex;
    align-items: center;
    margin-left: 0.5rem;
    white-space: nowrap;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-rose);
    transition: transform 0.3s var(--ease-spring);
  }
  .timeline__more:hover {
    transform: translateX(3px);
  }

  /* スクロールに合わせて、線が伸び、点が順に灯る（対応ブラウザのみ） */
  @supports (animation-timeline: view()) {
    .timeline::before {
      animation: draw linear both;
      animation-timeline: view();
      animation-range: entry 10% cover 60%;
    }
    .timeline__dot {
      animation: pop linear both;
      animation-timeline: view();
      animation-range: entry 30% entry 90%;
    }
    @keyframes draw {
      from {
        transform: scaleY(0);
      }
      to {
        transform: scaleY(1);
      }
    }
    @keyframes pop {
      from {
        transform: scale(0);
      }
      to {
        transform: scale(1);
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .timeline::before,
    .timeline__dot {
      animation: none;
    }
  }
</style>
