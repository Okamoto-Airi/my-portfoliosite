---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<footer id="contact" class="relative overflow-hidden bg-sakura-tint px-5 pb-10 pt-24 sm:px-8">
  <div class="mx-auto max-w-6xl">
    <h2 class="font-display text-4xl font-black text-ink sm:text-5xl">Contact</h2>
    <p class="mt-6 font-display text-xl font-bold text-ink sm:text-2xl">ご覧いただきありがとうございました</p>
    <p class="mt-1 text-ink-soft">Thank you for your time and interest!</p>

    <div class="mt-8 flex flex-wrap gap-4">
      <a
        href={`mailto:${site.email}`}
        class="contact-button bg-sakura text-ink hover:bg-sakura-soft"
        data-track="contact_click"
        data-track-method="email"
      >
        <Icon name="mail" />
        <span>Email</span>
      </a>
      <a
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
        class="contact-button bg-ink text-white hover:bg-ink-soft"
        data-track="contact_click"
        data-track-method="github"
      >
        <Icon name="github" />
        <span>GitHub</span>
        <span class="sr-only">（新しいタブで開きます）</span>
      </a>
    </div>

    <p class="mt-20 text-sm text-ink-soft">© 2026 {site.author}. All rights reserved.</p>
    {
      import.meta.env.PUBLIC_GA_MEASUREMENT_ID && (
        <p class="mt-2 text-xs text-ink-soft">
          このサイトでは、閲覧状況を知るために Google アナリティクスを使っています。個人を特定する情報は集めていません。
        </p>
      )
    }
  </div>
</footer>

<style>
  .contact-button {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1.6rem;
    border-radius: 999px;
    font-weight: 700;
    transition:
      transform 0.3s var(--ease-spring),
      background-color 0.2s;
  }
  .contact-button:hover {
    transform: translateY(-3px);
  }
  .contact-button:active {
    transform: translateY(0) scale(0.97);
  }
</style>
